# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------

# "prometheus" queries Prometheus directly (recommended)
# "grafana"    queries via Grafana's datasource proxy (requires token + uid)
DATASOURCE_TYPE="prometheus"

PROMETHEUS_URL="http://localhost:9090"

GRAFANA_URL="http://localhost:3000"
GRAFANA_TOKEN=""              # service account token
GRAFANA_DATASOURCE_UID=""     # UID from Grafana datasource settings

# ---------------------------------------------------------------------------
# IPMI target
# ---------------------------------------------------------------------------

# Set to "true" to use local IPMI device (/dev/ipmi0).
# Set to "false" to connect to a remote BMC.
IPMI_LOCAL=true

# Only used when IPMI_LOCAL=false
IPMI_HOST=""
IPMI_USER="root"
IPMI_PASS=""

# ---------------------------------------------------------------------------
# Temperature sensors
# ---------------------------------------------------------------------------
# Each entry is a colon-separated triple:  name:promql:weight
#
# Weight controls how aggressively this sensor drives the fan.
# A weight of 1.0 uses the curve as-is; 0.8 slightly softens the response.
# When multiple sensors are active, the highest weighted speed wins.
#
# Examples use node_exporter metrics — adjust to match your environment.

TEMP_SENSORS=(
  "cpu:avg(node_hwmon_temp_celsius{chip=~\"coretemp.*\",sensor=\"temp1\"}):1.0"
  "nvme:max(node_hwmon_temp_celsius{chip=~\"nvme.*\",sensor=\"temp1\"}):0.8"
  "ambient:node_hwmon_temp_celsius{chip=\"acpitz\",sensor=\"temp1\"}:0.6"
)

# ---------------------------------------------------------------------------
# Fan curve
# ---------------------------------------------------------------------------
# Breakpoints in "celsius:percent" format, sorted ascending.
# Fan speed is linearly interpolated between breakpoints.
# Below the first point: minimum speed. Above the last: 100%.

FAN_CURVE=(
  "30:10"
  "50:30"
  "65:55"
  "75:80"
  "82:100"
)

# ---------------------------------------------------------------------------
# PCIe cooling response
# ---------------------------------------------------------------------------

# Dell BMCs detect unrecognised third-party PCIe cards (e.g. non-Dell GPUs)
# and respond by ramping fans to ~100% regardless of actual temperature.
# Setting this to "true" disables that behaviour at startup, letting
# dellipmifanctl manage fan speed purely from temperature data.
#
# WARNING: Only enable this if you have verified that your fan curve provides
# adequate cooling under full CPU + GPU load. Run extended stress tests first.
# dellipmifanctl will restore the default PCIe cooling response on shutdown.
DISABLE_PCIE_COOLING_RESPONSE=false

# ---------------------------------------------------------------------------
# Safety and limits
# ---------------------------------------------------------------------------

# If any sensor exceeds this temperature, hand control back to BMC auto mode
# and log a warning. dellipmifanctl will attempt to resume manual mode after one cycle.
TEMP_CRITICAL=90

# Absolute floor — never command a speed below this percentage
MIN_FAN_SPEED=10

# Seconds between each poll → compute → apply cycle
POLL_INTERVAL=30

# How many consecutive data-fetch failures before falling back to BMC auto mode
MAX_FETCH_FAILURES=3
