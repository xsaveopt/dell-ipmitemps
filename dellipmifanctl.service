[Unit]
Description=Dell IPMI Fan Temperature Controller
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/dellipmifanctl
Restart=on-failure
RestartSec=15
# Give the script time to restore auto mode on stop
TimeoutStopSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dellipmifanctl

[Install]
WantedBy=multi-user.target
