# dellipmifanctl configuration. Copy to /etc/dellipmifanctl/config.yaml and edit.

# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
datasource:
  # "prometheus" queries Prometheus directly (recommended).
  # "grafana"    queries via Grafana's datasource proxy (requires token + uid).
  type: prometheus

  prometheus:
    url: http://localhost:9090

  grafana:
    url: http://localhost:3000
    token: ""           # service account token
    datasource_uid: ""  # UID from Grafana datasource settings

# ---------------------------------------------------------------------------
# IPMI target
# ---------------------------------------------------------------------------
ipmi:
  # true  -> use the local IPMI device (/dev/ipmi0)
  # false -> connect to a remote BMC over LAN+ (host/user/pass required)
  local: true
  host: ""
  user: root
  pass: ""

# ---------------------------------------------------------------------------
# Temperature sensors
# ---------------------------------------------------------------------------
# Each sensor pairs a PromQL query with a weight. Weight controls how
# aggressively this sensor drives the fan: 1.0 uses the curve as-is, 0.8
# softens the response. The highest weighted speed across sensors wins.
# Examples use node_exporter metrics — adjust to match your environment.
sensors:
  - name: cpu
    query: avg(node_hwmon_temp_celsius{chip=~"coretemp.*",sensor="temp1"})
    weight: 1.0
  - name: nvme
    query: max(node_hwmon_temp_celsius{chip=~"nvme.*",sensor="temp1"})
    weight: 0.8
  - name: ambient
    query: node_hwmon_temp_celsius{chip="acpitz",sensor="temp1"}
    weight: 0.6

# ---------------------------------------------------------------------------
# Fan curve
# ---------------------------------------------------------------------------
# Breakpoints sorted ascending by temp. Fan speed is linearly interpolated
# between breakpoints. Below the first point: that point's percent. Above the
# last point: 100%.
fan_curve:
  - { temp: 30, percent: 10 }
  - { temp: 50, percent: 30 }
  - { temp: 65, percent: 55 }
  - { temp: 75, percent: 80 }
  - { temp: 82, percent: 100 }

# ---------------------------------------------------------------------------
# PCIe cooling response
# ---------------------------------------------------------------------------
# Dell BMCs detect unrecognised third-party PCIe cards (e.g. non-Dell GPUs) and
# respond by ramping fans to ~100% regardless of actual temperature. Setting
# this to true disables that behaviour at startup, letting dellipmifanctl manage
# fan speed purely from temperature data.
#
# WARNING: only enable this if you have verified your fan curve provides
# adequate cooling under full CPU + GPU load. Run extended stress tests first.
# dellipmifanctl restores the default PCIe cooling response on shutdown.
disable_pcie_cooling_response: false

# ---------------------------------------------------------------------------
# Safety and limits
# ---------------------------------------------------------------------------
# If any sensor exceeds this temperature, hand control back to BMC auto mode and
# log a warning. Manual control resumes once temperatures fall back to normal.
temp_critical: 90

# Absolute floor — never command a speed below this percentage.
min_fan_speed: 10

# Seconds between each poll → compute → apply cycle.
poll_interval: 30

# Consecutive data-fetch failures before failing safe. On data loss the daemon
# stays in manual control and pins the fans to fetch_failure_fan_speed rather
# than handing back to the BMC, since the BMC cannot see the lost sensors.
max_fetch_failures: 3

# Fan speed (percent) to pin fans to once max_fetch_failures is reached, until
# sensor data returns. Defaults to 100 — full cooling while flying blind.
fetch_failure_fan_speed: 100

# ---------------------------------------------------------------------------
# Prediction (optional, default off)
# ---------------------------------------------------------------------------
# When enabled, fans are driven off a short window of recent history instead of
# the latest instantaneous sample. A robust quantile over the window rejects
# brief spikes (e.g. a 1-second NVMe blip) by construction, while a short
# linear-trend extrapolation still ramps early on a genuine sustained rise.
# Disabled -> behaviour is identical to instant-query mode.
prediction:
  enabled: false
  lookback: 120s        # window of history queried each poll (Prometheus query_range)
  step: 10s             # query_range resolution; should match ~scrape interval
  quantile: 0.9         # robust aggregate over the window (lower = more spike-tolerant)
  trend_horizon: 30s    # how far ahead the linear trend is extrapolated
  # When prediction is on, the critical fallback uses a *sustained* check: a
  # temperature must stay at/above temp_critical for this long before handing
  # control back to the BMC, so a momentary blip past the limit is ignored.
  critical_dwell: 15s

# ---------------------------------------------------------------------------
# Process pre-emption (optional, default off)
# ---------------------------------------------------------------------------
# Watches local /proc for newly-spawned processes and learns each process
# name's thermal signature over time (persisted to model_path):
#   - sustained load  -> pre-warm: raise a temporary fan floor when it reappears
#   - brief transient -> hold: keep the current speed steady through the spike
# A hold is time-bounded AND broken the instant temperature exceeds the learned
# envelope, and is always overridden by the critical fallback — it can delay a
# ramp on a known transient but can never under-cool a real sustained rise.
#
# Requires the daemon to run ON the monitored host (it reads that host's /proc)
# and to have write access to model_path.
process_prediction:
  enabled: false
  proc_path: /proc
  model_path: /var/lib/dellipmifanctl/procmodel.json
  min_observations: 3   # confirmations before a process is trusted to act on
  impact_threshold: 3.0 # minimum learned °C rise before a process is acted on
  preempt_ttl: 60s      # max lifetime of a pre-warm / hold hint
  hold_margin: 1.25     # break a hold once temp exceeds learned peak * this
  decay: 0.3            # weight given to each new observation (EWMA)
